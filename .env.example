# Copy this file to .env.local and fill in what you have. Never commit .env.local.
# Keys are only read on the server and are never sent to the browser or printed in the logs.
# Leave everything empty to run JARVIS in DEMO MODE.
# Keys saved from Settings go to ~/.jarvis/keys.env instead; a key set here wins.

# Claude — the JARVIS brain. https://console.anthropic.com → API Keys (billing must be set up)
ANTHROPIC_API_KEY=
# Optional: override the Claude model
JARVIS_MODEL=

# JARVIS in Telegram: the token of a NEW bot made only for JARVIS (@BotFather → /newbot).
# Used when no bot was set up in Settings → "JARVIS Telegram'da". On start the terminal
# prints a 6-digit code: send it to the bot once to pair your chat. The bot must not be
# used by any other program (two programs polling one token cause "409 Conflict").
TELEGRAM_BOT_TOKEN=

# Gemini: voice messages in Telegram, natural voice (incl. Uzbek), and chat when no Claude key.
# Get one at aistudio.google.com
GEMINI_API_KEY=
# Optional overrides
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
# GEMINI_VOICE=Charon

# ElevenLabs voice (reserved for a later phase; not used yet).
ELEVENLABS_API_KEY=

# Optional: where JARVIS keeps its data (memories, conversations, alerts, bot settings). Default ~/.jarvis
# JARVIS_HOME=
# Optional: how often price alerts are checked, in milliseconds. Default 60000
# JARVIS_ALERT_INTERVAL_MS=
