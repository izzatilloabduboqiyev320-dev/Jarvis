# Copy this file to .env.local and fill in what you have.
# Keys are only read on the server and are never sent to the browser.
# Leave everything empty to run JARVIS in DEMO MODE.

# Claude — the JARVIS brain (Phase 2)
ANTHROPIC_API_KEY=
# Optional: override the Claude model
JARVIS_MODEL=

# Voice output (Phase 5). Without it JARVIS uses the browser's voice.
ELEVENLABS_API_KEY=

# Telegram notifications (later phase)
TELEGRAM_BOT_TOKEN=
